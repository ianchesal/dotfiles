{{- /*
  Work machines and the cloud workstation keep their own ~/.ssh: the skeleton
  config, keys and 1Password socket link are for personal machines only. This
  is a deliberate exception to "every config deploys everywhere" (see AGENTS.md). destDir, not
  homeDir, so a scratch --destination can exercise both branches.
*/ -}}
{{- if or (stat (joinPath .chezmoi.destDir ".work_machine")) (stat "/etc/workstation-startup.d") }}
.ssh
.ssh/**
.1password
.1password/**
{{- end }}
{{- /*
  ~/.1password/agent.sock is a symlink only on macOS (work/gcw boxes never get
  it, above). On Linux 1Password creates the socket itself, and on WSL the zsh
  relay serves it -- chezmoi must never touch it there.
*/ -}}
{{- if ne .chezmoi.os "darwin" }}
.1password
.1password/**
{{- end }}
