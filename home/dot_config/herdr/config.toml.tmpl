# herdr -- https://herdr.dev
#
# Set up to feel like ../tmux/tmux.conf: same prefix, same popups, same
# Ctrl-h/j/k/l across nvim splits and panes. tmux maps onto herdr as
# session -> workspace, window -> tab, pane -> pane.
#
# This file is chezmoi-managed. herdr's own settings screen writes back to it,
# so a change made there is overwritten by the next `chezmoi apply` -- edit
# home/dot_config/herdr/config.toml.tmpl in the repo instead, then apply and
# `herdr server reload-config`. It is a template (for the machine marker
# below), so check the rendered copy:
#   chezmoi execute-template < home/dot_config/herdr/config.toml.tmpl > /tmp/herdr.toml
#   HERDR_CONFIG_PATH=/tmp/herdr.toml herdr config check
# Full default config: `herdr --default-config`.

onboarding = false

[update]
# Homebrew owns the install; `herdr update` would fight it.
version_check = false

[theme]
# Same palette as ../tmux/theme.conf.
name = "tokyo-night"

# Machine marker: remote boxes recolor the tab bar so they can't be mistaken
# for the machine you're sitting at. accent is the active-tab chip, panel_bg
# the rest of the tab row, sidebar_bg the sidebar. Local machines (macOS,
# dads-gaming-pc) keep stock tokyo-night.
#
# herdr themes are client-side: this shows when herdr runs ON the box (ssh in,
# then `herdr`). Viewing a saved machine from a local herdr uses the local
# theme -- the sidebar rules under [ui.sidebar.agents] and [ui.sidebar.spaces]
# cover that case.
{{- if stat "/etc/workstation-startup.d" }}
# Cloud workstation: lime, same as theme-gcw.conf and the gcw prompt.
[theme.custom]
accent = "#b8ff2e"
panel_bg = "#26331c"
sidebar_bg = "#141c0e"
{{- else if eq .chezmoi.hostname "tranquility" }}
# tranquility: orange.
[theme.custom]
accent = "#ff9e64"
panel_bg = "#3d2817"
sidebar_bg = "#21160d"
{{- end }}

[ui]
# tmux's prefix+c opens a window straight away; herdr asks for a name by default.
prompt_new_tab_name = false
tab_bar_right = [
  { type = "zoom" },
  # battery.sh writes tmux #[...] style codes; strip them, herdr shows text only.
  { type = "command", command = "~/.config/tmux/battery.sh | sed 's/#\\[[^]]*\\]//g'", interval_seconds = 30, timeout_seconds = 5 },
  { type = "datetime", format = "%Y-%m-%d %H:%M" },
  { type = "hostname" },
]
tab_bar_right_separator = " · "

# herdr's default agent rows, with the machine label colored to match the
# marker above. This is the only per-machine color a saved-machine view can
# show: the tab bar there uses this (local) theme whichever box you select.
[ui.sidebar.agents]
rows = [
  [
    "state_icon",
    { token = "machine", rules = [
      { equals = "tranquility", ignore_case = true, fg = "#ff9e64", bold = true },
      { equals = "gcw", ignore_case = true, fg = "#b8ff2e", bold = true },
    ] },
    "workspace",
    "tab",
  ],
  ["agent"],
]

# herdr's default space rows plus a machine badge. Space rows have no machine
# token, so each server reports its own name as workspace metadata `host`
# (../zsh/zshrc.d/herdr.zsh); this styles it. The last rule hides every other
# host, and a row whose only token is hidden disappears, so local workspaces
# look as they always have. Its own row so the workspace name isn't truncated.
[ui.sidebar.spaces]
rows = [
  ["state_icon", "workspace"],
  [
    { token = "$host", rules = [
      { equals = "tranquility", fg = "#ff9e64", bold = true },
      { equals = "gcw", fg = "#b8ff2e", bold = true },
      { contains = "", hide = true },
    ] },
  ],
  ["branch", "git_status"],
]

[keys]
prefix = "ctrl+b"

# Shift-Left/Right walk windows (tabs) with no prefix, as in tmux.
previous_tab = ["prefix+p", "shift+left"]
next_tab = ["prefix+n", "shift+right"]

# tmux's choose-tree lives on prefix+s; herdr's Go To picker is the equivalent.
goto = "prefix+s"
settings = "prefix+comma"

# prefix+d detaches, as in tmux. close_workspace stays on prefix+shift+d.
detach = "prefix+d"

# tmux split keys alongside herdr's own. split_vertical is side by side.
split_vertical = ["prefix+v", "prefix+|", "prefix+backslash"]
split_horizontal = ["prefix+minus", "prefix+_"]

# Copy mode on prefix+[, as in tmux. That is herdr's default too, but
# `herdr --default-config` doesn't list copy_mode, and another action bound to
# the same key silently disables it (only `herdr config check` on a config
# naming both says so). Pinned here so a future binding collides visibly.
# Brackets must be literal -- herdr rejects bracketleft/leftbracket.
copy_mode = "prefix+["

# Walk the agents list in the sidebar: focus the next/previous agent pane, in
# the order the panel shows them. Unbound by default. Braces, not brackets:
# prefix+[ is copy mode.
next_agent = "prefix+}"
previous_agent = "prefix+{"

# herdr's own worktree removal: confirms, takes the checkout and the workspace,
# keeps the branch. prefix+shift+a below is the workmux-style one that also
# deletes the branch. Not an alt chord: kitty on macOS doesn't send Option as alt.
remove_worktree = "prefix+shift+k"

# prefix+h is the gh-dash popup below; Ctrl-h covers moving left.
focus_pane_left = "ctrl+alt+h"

# Ctrl-h/j/k/l: move between nvim splits and herdr panes as one grid -- the
# vim-tmux-navigator behaviour. nav.sh passes the key to nvim when nvim is in
# the focused pane; nvim hands focus back out at its edge (see
# nvim/lua/plugins/vim-tmux-navigator.lua).
[[keys.command]]
key = "ctrl+h"
type = "shell"
command = "~/.config/herdr/nav.sh left"
description = "navigate left (nvim/herdr)"

[[keys.command]]
key = "ctrl+j"
type = "shell"
command = "~/.config/herdr/nav.sh down"
description = "navigate down (nvim/herdr)"

[[keys.command]]
key = "ctrl+k"
type = "shell"
command = "~/.config/herdr/nav.sh up"
description = "navigate up (nvim/herdr)"

[[keys.command]]
key = "ctrl+l"
type = "shell"
command = "~/.config/herdr/nav.sh right"
description = "navigate right (nvim/herdr)"

[[keys.command]]
key = "prefix+g"
type = "popup"
command = "lazygit"
description = "lazygit"
width = "90%"
height = "90%"

# tmux's prefix+w "open repo": fzf a checkout under ~/src into its own
# workspace, or focus the one already open on it.
[[keys.command]]
key = "prefix+f"
type = "popup"
command = "~/.config/herdr/open-repo.sh"
description = "open repo"
width = "80%"
height = "40%"

# tmux's prefix+w "add": worktree in <repo>__worktrees/, new workspace, claude.
[[keys.command]]
key = "prefix+a"
type = "popup"
command = "~/.config/herdr/add-worktree.sh"
description = "add worktree + claude"
width = "80%"
height = "20%"

# tmux's prefix+w "remove" (workmux remove): the focused worktree, its branch
# and its workspace, asking before each destructive step.
[[keys.command]]
key = "prefix+shift+a"
type = "popup"
command = "~/.config/herdr/remove-worktree.sh"
description = "remove worktree + branch"
width = "80%"
height = "40%"

# Wrapper picks the work or personal config from ~/.work_machine.
[[keys.command]]
key = "prefix+h"
type = "popup"
command = "~/.config/gh-dash/gh-dash.sh"
description = "gh dash"
width = "90%"
height = "90%"
