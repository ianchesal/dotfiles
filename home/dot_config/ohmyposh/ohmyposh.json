{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue-bell": "#78a9ff",
    "blue-black": "#353535",
    "celeste-blue": "#3ddbd9",
    "gcw-ink": "#16161e",
    "gcw-lime": "#b8ff2e",
    "light-sky-blue": "#82cfff",
    "main-bg": "#161616",
    "pastal-grey": "#f2f4f8",
    "pistachio-green": "#42be65",
    "t-background": "p:main-bg",
    "terminal-black": "#525252",
    "terminal-blue": "#78a9ff",
    "terminal-green": "#42be65",
    "terminal-magenta": "#be95ff",
    "terminal-red": "#ee5396",
    "terminal-white": "#f2f4f8",
    "terminal-yellow": "#ffcc66",
    "white-blue": "#f2f4f8"
  },
  "secondary_prompt": {
    "template": ">> ",
    "foreground": "p:terminal-magenta",
    "background": "transparent"
  },
  "transient_prompt": {
    "template": "> ",
    "foreground": "p:terminal-magenta",
    "foreground_templates": [
      "{{ if eq .Env.DOTFILES_MACHINE \"gcw\" }}p:gcw-lime{{ end }}"
    ],
    "background": "transparent",
    "newline": true
  },
  "console_title_template": "{{ if eq .Env.DOTFILES_MACHINE \"gcw\" }}[GCW] {{ .UserName }}@gcw{{ else }}{{ .UserName }}@{{ .HostName }}{{ end }} :: {{ .Folder }}",
  "terminal_background": "p:t-background",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "\n",
          "foreground": "p:terminal-blue",
          "background": "transparent",
          "type": "text",
          "style": "plain"
        },
        {
          "template": "{{ if eq .Env.DOTFILES_MACHINE \"gcw\" }}<b> GCW </b><,transparent> </>{{ end }}",
          "foreground": "p:gcw-ink",
          "background": "p:gcw-lime",
          "type": "text",
          "style": "plain"
        },
        {
          "template": "{{ if or .SSHSession (eq .Env.DOTFILES_MACHINE \"gcw\") }}{{ if eq .Env.DOTFILES_MACHINE \"gcw\" }}{{ .UserName }}@gcw{{ else }}{{ .UserName }}@{{ .HostName }}{{ end }} {{ end }}",
          "foreground": "p:terminal-yellow",
          "foreground_templates": [
            "{{ if eq .Env.DOTFILES_MACHINE \"gcw\" }}p:gcw-lime{{ end }}"
          ],
          "type": "session",
          "style": "plain"
        },
        {
          "options": {
            "branch_icon": "",
            "commit_icon": "@",
            "merge_icon": "MERGE ",
            "cherry_pick_icon": "PICK ",
            "revert_icon": "REVERT ",
            "fetch_status": true
          },
          "template": "<b>{{ .RepoName }}{{ if .RelativeDir }}/{{ $parts := splitList \"/\" .RelativeDir }}{{ if and (gt (len .RelativeDir) 30) (gt (len $parts) 2) }}\u2026/{{ index $parts (sub (len $parts) 2) }}/{{ last $parts }}{{ else }}{{ .RelativeDir }}{{ end }}{{ end }}</b> <p:terminal-white>on</> {{ if .Rebase }}<p:terminal-red>REBASE {{ .Rebase.HEAD }} onto {{ .Rebase.Onto }} {{ .Rebase.Current }}/{{ .Rebase.Total }}</>{{ else if or .Merge .CherryPick .Revert }}<p:terminal-red>{{ .HEAD }}</>{{ else }}<p:pistachio-green>{{ .HEAD }}</>{{ end }}{{ if .Staging.Changed }}<p:terminal-yellow>~</>{{ end }}{{ if .Working.Changed }}<p:terminal-red>*</>{{ end }}{{ if or (gt .Ahead 0) (gt .Behind 0) }} <p:terminal-green>{{ if gt .Ahead 0 }}\u2191{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }}\u2193{{ .Behind }}{{ end }}</>{{ end }}{{ if gt .StashCount 0 }} <p:terminal-yellow>${{ .StashCount }}</>{{ end }}{{ if .IsWorkTree }} <p:terminal-black>worktree</>{{ end }} ",
          "type": "git",
          "style": "plain",
          "foreground": "p:terminal-blue",
          "foreground_templates": [
            "{{ if eq .Env.DOTFILES_MACHINE \"gcw\" }}p:gcw-lime{{ end }}"
          ]
        },
        {
          "options": {
            "style": "powerlevel",
            "max_width": 40,
            "display_root": true
          },
          "template": "{{ if not (.Segments.Contains \"Git\") }}<b>{{ .Path }}</b> {{ end }}",
          "foreground": "p:terminal-blue",
          "foreground_templates": [
            "{{ if eq .Env.DOTFILES_MACHINE \"gcw\" }}p:gcw-lime{{ end }}"
          ],
          "type": "path",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "template": " {{ .FormattedMs }}",
          "foreground": "p:terminal-yellow",
          "type": "executiontime",
          "style": "powerline",
          "options": {
            "threshold": 2000
          }
        },
        {
          "type": "ruby",
          "style": "plain",
          "foreground": "p:terminal-red",
          "template": " rb {{ .Full }}"
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:terminal-green",
          "template": " node {{ .Full }}"
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:celeste-blue",
          "template": " go {{ .Full }}"
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:terminal-yellow",
          "template": " py {{ .Full }}{{ if .Venv }} ({{ .Venv }}){{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "{{ if gt .Code 0 }}<p:terminal-red>\u2717 {{ .Code }} ></>{{ else if eq .Env.DOTFILES_MACHINE \"gcw\" }}<p:gcw-lime>></>{{ else }}<p:terminal-magenta>></>{{ end }}",
          "foreground": "p:terminal-magenta",
          "background": "transparent",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "tooltips": [
    {
      "foreground": "p:light-sky-blue",
      "type": "aws",
      "style": "powerline",
      "tips": [
        "aws"
      ]
    },
    {
      "foreground": "p:light-sky-blue",
      "type": "gcp",
      "style": "powerline",
      "tips": [
        "gcloud",
        "gsutil"
      ]
    },
    {
      "foreground": "p:terminal-magenta",
      "type": "kubectl",
      "style": "powerline",
      "tips": [
        "kubectl",
        "k",
        "kubectx",
        "kubens"
      ]
    }
  ],
  "version": 4,
  "final_space": true
}
