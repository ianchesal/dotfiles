#!/usr/bin/env bash
# Thin loader: the real configuration lives under XDG-style
# ~/.config/bash so it stays consistent with the rest of this repo's
# tool configs (see zsh's ZDOTDIR indirection for the same idea).

# bash sources ~/.bashrc for non-interactive shells too (e.g. `ssh host
# cmd`, anything using BASH_ENV) -- bail out immediately in that case,
# same guard Debian's own skel .bashrc uses, since aliases aren't even
# expanded non-interactively and the full chain costs real time to load.
[[ $- == *i* ]] || return

# .bash_profile sources both ~/.profile and ~/.bashrc, and on Debian/WSL2
# ~/.profile itself sources ~/.bashrc -- without this guard a login shell
# loads the whole bashrc.d chain twice, doubling PROMPT_COMMAND and every
# eval'd integration (oh-my-posh, fzf).
[[ -n ${BASH_RC_LOADED:-} ]] && return
BASH_RC_LOADED=1

[[ -f "$HOME/.config/bash/bashrc.sh" ]] && source "$HOME/.config/bash/bashrc.sh"
