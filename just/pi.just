set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# pi is deliberately NOT asdf-managed. As an npm global it lands inside one
# node version's tree, and asdf shims are per-version -- so the moment a repo's
# .tool-versions pinned a different node, `pi` vanished there with "No version
# is set for command pi". Instead it runs on Homebrew's node (brew/Brewfile) out
# of its own prefix, which no .tool-versions can reach.
#
# The prefix is deliberately off PATH. npm would otherwise drop a bin/pi whose
# shebang is `#!/usr/bin/env node`, and that resolves node through the asdf
# shims again -- back to an interpreter that changes per directory. Only the
# generated wrapper is on PATH, and it names brew's node outright.
#
# The wrapper is machine-local and untracked, same category as the _claude
# completion spec: it bakes in a brew prefix that differs between macOS
# (/opt/homebrew) and Linux (/home/linuxbrew/.linuxbrew).
#
# Homebrew lives outside the environment a task runner inherits on some boxes,
# so every recipe re-resolves it explicitly rather than trusting `command -v` --
# the same belt-and-braces lookup rust.just does for rustup.

pi_prefix := "$HOME/.local/share/pi"
pi_wrapper := "$HOME/.local/bin/pi"
pi_pkg := "@earendil-works/pi-coding-agent"

# Install pi on Homebrew's node, into its own prefix
install:
    #!/usr/bin/env bash
    set -euo pipefail
    brew_bin=$(command -v brew 2>/dev/null || true)
    for candidate in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
      [ -n "$brew_bin" ] && break
      [ -x "$candidate" ] && brew_bin=$candidate
    done
    if [ -z "$brew_bin" ]; then
      printf '\033[31m%s\033[0m\n' 'Cannot install pi -- Homebrew not found'
      exit 1
    fi
    brew_prefix=$("$brew_bin" --prefix)
    if [ ! -x "$brew_prefix/bin/node" ]; then
      printf '\033[31m%s\033[0m\n' 'Cannot install pi -- brew node not installed'
      printf '\033[33m%s\033[0m\n' "Run: brew bundle --file=$REPO/brew/Brewfile"
      exit 1
    fi
    printf '\033[32m%s\033[0m\n' 'Install: pi'
    # --prefix overrides whatever ~/.npmrc sets, so this lands in pi's own tree
    # no matter how npm is configured on the machine.
    "$brew_prefix/bin/npm" install -g --prefix "{{ pi_prefix }}" "{{ pi_pkg }}"
    mkdir -p "$(dirname "{{ pi_wrapper }}")"
    {
      printf '#!/usr/bin/env bash\n'
      printf '# Generated by `just pi::install` -- edit that recipe, not this file.\n'
      printf '# The interpreter is named outright so no .tool-versions can redirect it.\n'
      printf 'set -euo pipefail\n'
      printf 'exec "%s/bin/node" \\\n' "$brew_prefix"
      printf '  "%s/lib/node_modules/%s/dist/bundle/cli.js" "$@"\n' "{{ pi_prefix }}" "{{ pi_pkg }}"
    } >"{{ pi_wrapper }}"
    chmod +x "{{ pi_wrapper }}"
    printf '\033[32mpi %s installed at %s\033[0m\n' "$("{{ pi_wrapper }}" --version)" "{{ pi_wrapper }}"

# Update pi and its extensions, when pi is installed
update:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -x "{{ pi_wrapper }}" ]; then
      printf '\033[31m%s\033[0m\n' 'No updates to pi performed -- pi not installed (just pi::install)'
      exit 0
    fi
    brew_bin=$(command -v brew 2>/dev/null || true)
    for candidate in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
      [ -n "$brew_bin" ] && break
      [ -x "$candidate" ] && brew_bin=$candidate
    done
    if [ -z "$brew_bin" ] || [ ! -x "$("$brew_bin" --prefix)/bin/npm" ]; then
      printf '\033[31m%s\033[0m\n' 'No updates to pi performed -- brew npm not found'
      exit 0
    fi
    npm_bin=$("$brew_bin" --prefix)/bin/npm
    printf '\033[32m%s\033[0m\n' 'Update: pi'
    old_version=$("{{ pi_wrapper }}" --version 2>/dev/null || true)
    # Driving npm ourselves, rather than `pi update --self`, keeps this prefix
    # authoritative: pi's own updater would install wherever ~/.npmrc points.
    "$npm_bin" install -g --prefix "{{ pi_prefix }}" "{{ pi_pkg }}@latest" </dev/null
    new_version=$("{{ pi_wrapper }}" --version 2>/dev/null || true)
    if [ "$old_version" != "$new_version" ]; then
      printf '\033[33mpi updated %s -> %s\033[0m\n' "$old_version" "$new_version"
    else
      printf '\033[32mpi already up to date (%s)\033[0m\n' "$new_version"
    fi
    # Extensions are pi's own business -- npm knows nothing about them. stdin is
    # closed so an unattended `just update` cannot stall on a prompt.
    printf '\033[32m%s\033[0m\n' 'Update: pi extensions'
    "{{ pi_wrapper }}" update --extensions </dev/null

# Uninstall pi and its wrapper
[confirm("Uninstall pi and everything in its prefix? [y/N]")]
uninstall:
    #!/usr/bin/env bash
    set -euo pipefail
    rm -rf "{{ pi_prefix }}"
    rm -f "{{ pi_wrapper }}"
    printf '\033[32m%s\033[0m\n' 'pi uninstalled'

# Remove pi installs that predate the canonical layout (one-shot)
purge-legacy:
    @"$REPO/script/pi-purge-legacy"

# Preview what purge-legacy would remove
purge-legacy-preview:
    @"$REPO/script/pi-purge-legacy" --preview
