#!/usr/bin/env bash
#
# Uninstall asdf tool versions older than the version in use.
#
# Ported from the asdf:prune rake task. The ordering that Gem::Version used to
# provide comes from `sort -V`; a version that sort -V cannot be trusted to
# order (`system`, `ref:<sha>`, `jruby-9.4.5.0`) is never pruned, because
# without an ordering there is no way to know it is older than what is in use.
#
# Deliberately not named "cleanup": it would sit one keystroke away from other
# clean tasks, and a typo here uninstalls toolchains.
#
# Usage:
#   asdf-prune              prune, prompting once before uninstalling
#   asdf-prune --preview    report the plan and exit without uninstalling
#
# Environment:
#   FORCE=1           skip the confirmation prompt
#   ASDF_BIN          asdf executable to drive (default: asdf) -- test seam
#   TOOL_VERSIONS     pin file to read  (default: ~/.tool-versions) -- test seam

set -euo pipefail

# mapfile and friends need bash 4+. macOS still ships bash 3.2 as /bin/bash, so
# fail loudly here rather than misbehaving quietly if brew's bash is not first
# on PATH (brew/Brewfile installs it).
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  echo "${0##*/}: needs bash 4+ (found ${BASH_VERSION:-unknown}); brew install bash" >&2
  exit 1
fi

ASDF_BIN=${ASDF_BIN:-asdf}
TOOL_VERSIONS=${TOOL_VERSIONS:-$HOME/.tool-versions}
FORCE=${FORCE:-0}

dry_run=0
case ${1:-} in
  --preview | --dry-run) dry_run=1 ;;
  "") ;;
  *)
    echo "usage: ${0##*/} [--preview]" >&2
    exit 2
    ;;
esac

if [ -t 1 ]; then
  red=$'\033[31m' green=$'\033[32m' yellow=$'\033[33m' gray=$'\033[37m' reset=$'\033[0m'
else
  red='' green='' yellow='' gray='' reset=''
fi

# A version sort -V orders the way a human would. Anything else -- `system`,
# `ref:<sha>`, `jruby-9.4.5.0` -- is left alone rather than guessed at.
comparable() { [[ $1 =~ ^[0-9]+(\.[0-9]+)*$ ]]; }

# True when $1 sorts strictly before $2.
version_lt() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" = "$1" ]
}

# Versions pinned for a plugin in ~/.tool-versions. A line may list several
# (asdf tries them left to right), so every version on it counts as in use.
pinned_for() {
  [ -f "$TOOL_VERSIONS" ] || return 0
  sed 's/#.*//' "$TOOL_VERSIONS" | awk -v plugin="$1" '$1 == plugin { for (i = 2; i <= NF; i++) print $i }'
}

# Versions of a plugin installed on this machine. asdf flags the version in use
# with a leading `*` and reports "no compatible versions installed" on stderr,
# so stdout parses cleanly and an empty result just means nothing is installed.
installed_for() {
  "$ASDF_BIN" list "$1" 2>/dev/null |
    sed 's/^[[:space:]]*//; s/^\*//; s/[[:space:]]*$//' |
    grep -v '^$' || true
}

plan=$(mktemp)
trap 'rm -f "$plan"' EXIT

total=0

while read -r plugin; do
  [ -n "$plugin" ] || continue

  mapfile -t installed < <(installed_for "$plugin")
  [ "${#installed[@]}" -gt 0 ] || continue

  comparable_versions=()
  skipped=()
  for version in "${installed[@]}"; do
    if comparable "$version"; then
      comparable_versions+=("$version")
    else
      skipped+=("$version")
    fi
  done

  mapfile -t in_use < <(pinned_for "$plugin")
  pinned=1
  if [ "${#in_use[@]}" -eq 0 ]; then
    # Unpinned: fall back to the newest install, which collapses the plugin to a
    # single version rather than leaving it untouched.
    pinned=0
    if [ "${#comparable_versions[@]}" -gt 0 ]; then
      mapfile -t in_use < <(printf '%s\n' "${comparable_versions[@]}" | sort -V | tail -n1)
    fi
  fi

  # A pin we cannot order (`ref:<sha>`) disables pruning for the whole plugin.
  # So does having no version in use at all -- there is no threshold to compare
  # against, and the Ruby this replaces raised on that case rather than skipping.
  prunable=()
  orderable=1
  for version in "${in_use[@]}"; do
    comparable "$version" || orderable=0
  done
  if [ "$orderable" -eq 1 ] && [ "${#in_use[@]}" -gt 0 ]; then
    threshold=$(printf '%s\n' "${in_use[@]}" | sort -V | head -n1)
    for version in "${comparable_versions[@]}"; do
      if version_lt "$version" "$threshold"; then
        prunable+=("$version")
        printf '%s\t%s\n' "$plugin" "$version" >>"$plan"
        total=$((total + 1))
      fi
    done
  fi

  # One-line headline, e.g. "ruby: using 4.0.6, 11 to remove".
  if [ "${#in_use[@]}" -eq 0 ]; then
    summary="$plugin: no version in use"
  else
    summary="$plugin: using $(
      IFS=', '
      echo "${in_use[*]}"
    )"
  fi
  [ "$pinned" -eq 1 ] || summary="$summary (unpinned, keeping newest)"
  if [ "${#prunable[@]}" -eq 0 ]; then
    printf '%s\n' "${green}${summary}, nothing to remove${reset}"
  else
    printf '%s\n' "${yellow}${summary}, ${#prunable[@]} to remove${reset}"
  fi
  for version in "${prunable[@]}"; do printf '  - %s\n' "$version"; done
  for version in "${skipped[@]}"; do
    printf '%s\n' "${gray}  ? ${version} (uncomparable version, left alone)${reset}"
  done
done < <("$ASDF_BIN" plugin list 2>/dev/null || true)

[ "$dry_run" -eq 0 ] || exit 0

if [ "$total" -eq 0 ]; then
  printf '%s\n' "${green}Nothing to remove${reset}"
  exit 0
fi

if [ "$FORCE" != "1" ]; then
  read -r -p "Uninstall $total tool versions? [y/N] " answer || answer=''
  case $answer in
    [yY]) ;;
    *)
      printf '%s\n' "${red}Aborted${reset}"
      exit 0
      ;;
  esac
fi

while IFS=$'\t' read -r plugin version; do
  echo "$ASDF_BIN uninstall $plugin $version"
  "$ASDF_BIN" uninstall "$plugin" "$version"
done <"$plan"
