#!/usr/bin/env bash
#
# chezmoi-migrate - finish the switch after script/chezmoi-prep (run on main)
# has converted this machine's symlinks into real files and directories.
#
#   ./script/chezmoi-migrate --dry-run    show the diff, apply nothing
#   ./script/chezmoi-migrate              do it
#
# Run this from the chezmoi branch, after:
#     ./script/chezmoi-prep        (on main)
#     git checkout <this branch>
set -euo pipefail

DRY=""
[ "${1:-}" = "--dry-run" ] && DRY=1

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
say()  { printf '\033[1;36m==> %s\033[0m\n' "$*"; }
ok()   { printf '    \033[0;32mok\033[0m   %s\n' "$*"; }
die()  { printf '\033[1;31mABORT: %s\033[0m\n' "$*" >&2; exit 1; }

say "Step 1/5: confirm chezmoi-prep has already run"
[ -f "$ROOT/.chezmoiroot" ] || die "no .chezmoiroot - are you on the chezmoi branch?"

# Scan for symlinks into the repo instead of consulting a hardcoded list. The
# old list (12 dirs + 6 files) silently omitted bash, codex, viddy, karabiner,
# goose and copilot, so this step reported "no symlinks remain" while seven
# still pointed here (three live, four dangling) -- and the dirty worktree in
# step 5 was the only symptom, under a message that named none of them. The
# three live ones were still being written to. A scan cannot drift out of date.
# $HOME/.config/nvim is the one deliberate exception (see CLAUDE.md).
stragglers=0
while IFS= read -r link; do
  [ -n "$link" ] || continue
  target="$(readlink "$link")"
  case "$target" in "$ROOT"/*) ;; *) continue ;; esac
  [ "$link" = "$HOME/.config/nvim" ] && continue
  [ -e "$link" ] && state="" || state=" (dangling)"
  echo "    ~/${link#"$HOME"/} is still a symlink -> $target$state"
  stragglers=$((stragglers+1))
done <<EOF
$(find "$HOME" "$HOME/.config" -maxdepth 1 -type l 2>/dev/null)
EOF
[ "$stragglers" -eq 0 ] || die "$stragglers symlink(s) still point into $ROOT - migrate or remove them first."
ok "no symlinks into the repo remain"

# nvim is the deliberate exception and must still be a link
[ -L "$HOME/.config/nvim" ] || die "\$HOME/.config/nvim should still be a symlink - prep should not have touched it"
ok "\$HOME/.config/nvim still symlinked (by design)"

say "Step 2/5: ensure chezmoi is installed"
if command -v chezmoi >/dev/null 2>&1; then
  ok "$(chezmoi --version | head -1)"
else
  [ -n "$DRY" ] && die "chezmoi is not installed (dry run will not install it)"
  if command -v brew >/dev/null 2>&1; then brew install chezmoi
  else sh -c "$(curl -fsLS https://get.chezmoi.io)" -- -b "$HOME/.local/bin"; export PATH="$HOME/.local/bin:$PATH"; fi
  ok "$(chezmoi --version | head -1)"
fi

say "Step 3/5: point chezmoi at this checkout"
# `chezmoi init --source=...` does NOT persist the path -- it applies to that
# invocation only, so every later command (and dfu) would need --source again.
# The durable setting is sourceDir in chezmoi's own config file.
CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi"
CFG="$CFG_DIR/chezmoi.toml"
current="$(chezmoi source-path 2>/dev/null || true)"
if [ "$current" = "$ROOT/home" ]; then
  ok "already pointed at $ROOT"
elif [ -n "$DRY" ]; then
  printf '    would: write sourceDir = "%s" to %s\n' "$ROOT" "$CFG"
else
  if [ -f "$CFG" ] && ! grep -q "^sourceDir" "$CFG"; then
    printf 'sourceDir = "%s"\n' "$ROOT" >> "$CFG"
  elif [ -f "$CFG" ]; then
    die "$CFG already sets sourceDir to something else - resolve that by hand"
  else
    mkdir -p "$CFG_DIR"
    printf 'sourceDir = "%s"\n' "$ROOT" > "$CFG"
  fi
  got="$(chezmoi source-path)"
  [ "$got" = "$ROOT/home" ] || die "sourceDir did not take: chezmoi reports $got"
  ok "source is $got (persisted in $CFG)"
fi

say "Step 4/5: review what would change"
# no --source here on purpose: this must exercise the persisted config,
# so a sourceDir that did not take fails loudly rather than silently working
chezmoi diff || true
cat <<'EOF'

    Read that diff. On this machine chezmoi has no record of what it wrote
    before, so `apply` treats every existing file as unmanaged and will
    replace it WITHOUT prompting. The diff above is your only preview.
EOF

if [ -n "$DRY" ]; then
  printf '\n\033[1;33mDry run - nothing applied.\033[0m\n'; exit 0
fi

printf '\n    Apply these changes? [y/N] '
read -r reply
case "$reply" in [yY]*) ;; *) echo "    aborted."; exit 1 ;; esac

say "Step 5/5: apply and verify"
chezmoi apply --error-on-conflict

fails=0
check() { if eval "$2"; then ok "$1"; else echo "    FAIL: $1"; fails=$((fails+1)); fi; }
check "chezmoi status is clean"        '[ -z "$(chezmoi status)" ]'
check ".config/nvim -> repo"           '[ "$(readlink "$HOME/.config/nvim")" = "$ROOT/nvim" ]'
check ".zshenv is a real file"         '[ -f "$HOME/.zshenv" ] && [ ! -L "$HOME/.zshenv" ]'
# Only assert about .config/nvim - the one symlink this script is responsible
# for. A blanket $HOME scan (as this used to do) also catches unrelated
# pre-existing stale symlinks (old configs, rotated logs, uninstalled plugin
# binaries) that have nothing to do with this migration; see 9ab83f96, which
# made the same fix to chezmoi-prep's identical check.
check ".config/nvim resolves"          '[ -e "$HOME/.config/nvim" ]'
# Capture the paths, not just the boolean. This check used to fail with nothing
# but its own name, which hid the real cause: `Prep for chezmoi` (753876c)
# deleted the tracked files out of copilot/, goose/, karabiner/ and serena/,
# but git leaves untracked files alone, so each dir survived holding only the
# tool droppings that were still being written through un-migrated symlinks.
worktree_dirty="$(git -C "$ROOT" status --porcelain || true)"
check "repo worktree is clean"         '[ -z "$worktree_dirty" ]'
[ -z "$worktree_dirty" ] || printf '%s\n' "$worktree_dirty" | sed 's/^/         /'
[ -d "$HOME/.claude/projects" ] && check ".claude/projects survived" 'true'
[ -f "$HOME/.config/gh/hosts.yml" ] && check "gh hosts.yml survived" 'true'

echo
if [ "$fails" -eq 0 ]; then
  printf '\033[1;32mMigration complete.\033[0m Try: zsh -ic %s and: gh auth status\n' "'echo ok'"
else
  die "$fails check(s) failed - your backup is at ~/dotfiles-pre-chezmoi-*.tgz"
fi
